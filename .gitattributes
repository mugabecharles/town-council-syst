# TCMS - Git line-ending normalization
# Ensure consistent LF on all platforms

* text=auto

# Force LF for server-side files (PHP, shell, YAML, SQL)
*.php      text eol=lf
*.sh       text eol=lf
*.sql      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.txt      text eol=lf
*.htaccess text eol=lf
Dockerfile text eol=lf

# Binary files - no line ending conversion
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.docx     binary
*.xlsx     binary
*.zip      binary
