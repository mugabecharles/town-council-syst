# ── TCMS Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Database
DB_HOST=localhost
DB_NAME=tcms_db
DB_USER=root
DB_PASS=

# Application
APP_URL=http://localhost/Town%20Council%20syst
APP_ENV=development
# APP_ENV options: development | production

# Council Branding
COUNCIL_NAME="Kijura Town Council"

# Security
SESSION_TIMEOUT=1800
